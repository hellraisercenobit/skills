{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellraisercenobit/skills/blob/main/skills/engineering/transpose-modern-typescript/references/decision-record.schema.json",
  "title": "Modern TypeScript decision record 2.0.0",
  "description": "Shape and catalog membership only, on the suite's common decision envelope. Validation does not establish compatibility, correctness or decision timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimension",
    "schemaVersion",
    "catalogVersion",
    "contractVersions",
    "need",
    "scope",
    "base",
    "revision",
    "cites",
    "plans",
    "inventory",
    "profile",
    "sites"
  ],
  "properties": {
    "dimension": {
      "const": "modern-typescript"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "catalogVersion": {
      "const": "1.1.0"
    },
    "contractVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "1.0.0",
          "1.1.0"
        ]
      }
    },
    "need": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "cites": {
      "description": "Artifacts and evidence sources that exist when the record is validated. A dangling path refuses the record.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "plans": {
      "description": "Artifacts this record commits to produce, with this dimension's roles.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "implementation",
              "check-output",
              "consumer-types"
            ]
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "previous",
        "reason"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "changed": {
          "description": "The cited paths this revision changed. Enforcement verifies their hashes differ from the previous revision's snapshot.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "addresses": {
          "description": "Finding identifiers this revision closes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 2
              }
            },
            "required": [
              "number"
            ]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idioms",
        "data-access",
        "consumption",
        "lifetime",
        "async",
        "platform",
        "types",
        "modules"
      ],
      "properties": {
        "idioms": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "data-access": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "consumption": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "lifetime": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "async": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "platform": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "types": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "modules": {
          "$ref": "#/$defs/inventoryAxis"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "compiler",
        "declarations",
        "build",
        "targets",
        "evidence"
      ],
      "properties": {
        "language": {
          "enum": [
            "typescript",
            "javascript"
          ]
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "declarations": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "checkedAt",
              "claim",
              "covers"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "ruleIds",
          "alternatives",
          "decision",
          "consumption",
          "benefits",
          "artifacts",
          "invariants"
        ],
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ruleId"
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "assessment"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "current",
                    "native",
                    "library",
                    "custom"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "assessment": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "current"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choice",
              "idioms",
              "mechanism",
              "action",
              "reason",
              "tradeoffs",
              "reconsiderWhen"
            ],
            "properties": {
              "choice": {
                "enum": [
                  "idioms",
                  "none"
                ]
              },
              "idioms": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/ruleId"
                }
              },
              "mechanism": {
                "enum": [
                  "native",
                  "library",
                  "custom"
                ]
              },
              "action": {
                "enum": [
                  "apply",
                  "retain"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reconsiderWhen": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "choice": {
                      "const": "none"
                    }
                  },
                  "required": [
                    "choice"
                  ]
                },
                "then": {
                  "properties": {
                    "idioms": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "idioms": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "semanticDelta": {
            "$ref": "#/$defs/semanticDelta"
          },
          "consumption": {
            "$ref": "#/$defs/consumption"
          },
          "benefits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "claim",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "readability",
                    "maintenance",
                    "safety",
                    "algorithmic",
                    "allocation",
                    "measured"
                  ]
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "symbol"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "const": "apply"
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "required": [
                "semanticDelta"
              ],
              "properties": {
                "semanticDelta": {
                  "$ref": "#/$defs/semanticDelta"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "checkedAt",
        "claim",
        "covers"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "searched": {
          "description": "Paths consulted and not found, for a claim of unknown about a checkable fact.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inventoryAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "sites"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "sites": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ruleId": {
      "enum": [
        "MT-01",
        "MT-02",
        "MT-03",
        "MT-04",
        "MT-05",
        "MT-06",
        "MT-07",
        "MT-08",
        "MT-09",
        "MT-10",
        "MT-11",
        "MT-12",
        "MT-13",
        "MT-14",
        "MT-15",
        "MT-16",
        "MT-17",
        "MT-18",
        "MT-19",
        "MT-20",
        "MT-21",
        "MT-22",
        "MT-23",
        "MT-24",
        "MT-25"
      ]
    },
    "semanticDelta": {
      "description": "Required when the decision's action is `apply`: what observably survives the change and what deliberately does not. MT-24 covers the static half of the same question.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "preserved"
      ],
      "properties": {
        "expected": {
          "enum": [
            "none",
            "intended"
          ]
        },
        "preserved": {
          "description": "The observable properties this change keeps. Name every one considered; an empty list means none of them applies and the reason says so.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ordering",
              "duplicate-behavior",
              "key-semantics",
              "laziness",
              "error-behavior",
              "mutation-behavior"
            ]
          }
        },
        "intended": {
          "description": "The changes this decision means to make. Required and non-empty when `expected` is `intended`.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "property",
              "change",
              "reason"
            ],
            "properties": {
              "property": {
                "enum": [
                  "ordering",
                  "duplicate-behavior",
                  "key-semantics",
                  "laziness",
                  "error-behavior",
                  "mutation-behavior",
                  "type-information"
                ]
              },
              "change": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected": {
                "const": "intended"
              }
            },
            "required": [
              "expected"
            ]
          },
          "then": {
            "required": [
              "intended"
            ],
            "properties": {
              "intended": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "consumption": {
      "description": "How this site consumes its sequence. Declared applicable with its values, or excluded with a reason, so eager materialization of an unbounded sequence is never a silent omission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "eager",
            "lazy",
            "partial"
          ]
        },
        "cardinality": {
          "enum": [
            "bounded",
            "potentially-unbounded"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "required": [
              "mode",
              "cardinality"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "eager",
                  "lazy",
                  "partial"
                ]
              },
              "cardinality": {
                "enum": [
                  "bounded",
                  "potentially-unbounded"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "mode": false,
              "cardinality": false
            }
          }
        }
      ]
    }
  }
}
