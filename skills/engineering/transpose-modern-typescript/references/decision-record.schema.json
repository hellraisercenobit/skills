{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellraisercenobit/skills/blob/main/skills/engineering/transpose-modern-typescript/references/decision-record.schema.json",
  "title": "Modern TypeScript decision record 1.0.0",
  "description": "Shape and catalog membership only. Validation does not establish compatibility, correctness or decision timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimension",
    "schemaVersion",
    "catalogVersion",
    "contractVersion",
    "need",
    "scope",
    "revision",
    "inventory",
    "profile",
    "sites"
  ],
  "properties": {
    "dimension": {
      "const": "modern-typescript"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogVersion": {
      "const": "1.0.0"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "need": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "previous",
        "reason"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 2
              }
            },
            "required": [
              "number"
            ]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idioms",
        "data-access",
        "consumption",
        "lifetime",
        "async",
        "platform",
        "types",
        "modules"
      ],
      "properties": {
        "idioms": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "data-access": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "consumption": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "lifetime": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "async": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "platform": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "types": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "modules": {
          "$ref": "#/$defs/inventoryAxis"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "compiler",
        "declarations",
        "build",
        "targets",
        "evidence"
      ],
      "properties": {
        "language": {
          "enum": [
            "typescript",
            "javascript"
          ]
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "declarations": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "checkedAt",
              "claim",
              "covers"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "ruleIds",
          "alternatives",
          "decision",
          "benefits",
          "artifacts",
          "invariants"
        ],
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ruleId"
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "assessment"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "current",
                    "native",
                    "library",
                    "custom"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "assessment": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "current"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choice",
              "idioms",
              "mechanism",
              "action",
              "reason",
              "tradeoffs",
              "reconsiderWhen"
            ],
            "properties": {
              "choice": {
                "enum": [
                  "idioms",
                  "none"
                ]
              },
              "idioms": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/ruleId"
                }
              },
              "mechanism": {
                "enum": [
                  "native",
                  "library",
                  "custom"
                ]
              },
              "action": {
                "enum": [
                  "apply",
                  "retain"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reconsiderWhen": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "choice": {
                      "const": "none"
                    }
                  },
                  "required": [
                    "choice"
                  ]
                },
                "then": {
                  "properties": {
                    "idioms": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "idioms": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "benefits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "claim",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "readability",
                    "maintenance",
                    "safety",
                    "algorithmic",
                    "allocation",
                    "measured"
                  ]
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "symbol"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "inventoryAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "sites"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "sites": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ruleId": {
      "enum": [
        "MT-01",
        "MT-02",
        "MT-03",
        "MT-04",
        "MT-05",
        "MT-06",
        "MT-07",
        "MT-08",
        "MT-09",
        "MT-10",
        "MT-11",
        "MT-12",
        "MT-13",
        "MT-14",
        "MT-15",
        "MT-16",
        "MT-17",
        "MT-18",
        "MT-19",
        "MT-20",
        "MT-21",
        "MT-22",
        "MT-23"
      ]
    }
  }
}
