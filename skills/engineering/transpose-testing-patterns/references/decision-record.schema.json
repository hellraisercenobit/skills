{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellraisercenobit/skills/blob/main/skills/engineering/transpose-testing-patterns/references/decision-record.schema.json",
  "title": "Testing patterns decision record 1.0.0",
  "description": "Structure and catalog membership only; no semantic, chronology or execution certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimension",
    "schemaVersion",
    "catalogVersion",
    "contractVersion",
    "adapter",
    "need",
    "scope",
    "base",
    "revision",
    "profile",
    "inventory",
    "sites"
  ],
  "properties": {
    "dimension": {
      "const": "testing-patterns"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "catalogVersion": {
      "const": "1.0.0"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "vitest"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "need": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "previous",
        "reason"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 2
              }
            },
            "required": [
              "number"
            ]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "runner",
        "compiler",
        "declarations",
        "build",
        "configuration",
        "environments",
        "runtimes",
        "evidence"
      ],
      "properties": {
        "language": {
          "enum": [
            "typescript",
            "javascript"
          ]
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "declarations": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "checkedAt",
              "claim",
              "covers"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior",
        "process",
        "doubles",
        "data",
        "isolation",
        "testability",
        "types",
        "async-lifetime",
        "environment",
        "oracle",
        "execution"
      ],
      "properties": {
        "behavior": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "process": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "doubles": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "data": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "isolation": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "testability": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "types": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "async-lifetime": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "environment": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "oracle": {
          "$ref": "#/$defs/inventoryAxis"
        },
        "execution": {
          "$ref": "#/$defs/inventoryAxis"
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "behavior",
          "risk",
          "ruleIds",
          "alternatives",
          "form",
          "level",
          "seam",
          "oracle",
          "doubles",
          "data",
          "isolation",
          "decision",
          "invariants",
          "mode",
          "checks",
          "artifacts",
          "evidence"
        ],
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ruleId"
            },
            "uniqueItems": true
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "assessment"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "current",
                    "alternative"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "assessment": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "current"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "seam": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "doubles": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "string",
            "minLength": 1
          },
          "isolation": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choice",
              "patterns",
              "action",
              "reason",
              "tradeoffs",
              "limits",
              "reconsiderWhen"
            ],
            "properties": {
              "choice": {
                "enum": [
                  "specialized",
                  "none"
                ]
              },
              "patterns": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "#/$defs/ruleId"
                },
                "uniqueItems": true
              },
              "action": {
                "enum": [
                  "apply",
                  "retain"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reconsiderWhen": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "choice": {
                      "const": "none"
                    }
                  },
                  "required": [
                    "choice"
                  ]
                },
                "then": {
                  "properties": {
                    "patterns": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "patterns": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mode": {
            "enum": [
              "tdd",
              "characterization",
              "coverage",
              "audit"
            ]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "command",
                "guarantee"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "runtime",
                    "static",
                    "consumer-types",
                    "lint",
                    "build",
                    "coverage",
                    "other"
                  ]
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "guarantee": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ruleId": {
      "enum": [
        "TP-01",
        "TP-02",
        "TP-03",
        "TP-04",
        "TP-05",
        "TP-06",
        "TP-07",
        "TP-08",
        "TP-09",
        "TP-10",
        "TP-11",
        "TP-12",
        "TP-13",
        "TP-14",
        "TP-15",
        "TP-16"
      ]
    },
    "inventoryAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "sites"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "sites": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "sites": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
