{
  "name": "hellraisercenobit-skills",
  "version": "0.4.1",
  "private": true,
  "description": "Personal agent skills by Guillaume Mongin — versioned and composable",
  "author": {
    "name": "Guillaume Mongin",
    "url": "https://github.com/hellraisercenobit"
  },
  "repository": {
    "type": "git",
