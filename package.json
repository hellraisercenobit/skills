{
  "name": "hellraisercenobit-skills",
  "version": "0.8.0",
  "private": true,
  "description": "Personal agent skills by Guillaume Mongin — versioned and composable",
  "author": {
    "name": "Guillaume Mongin",
    "url": "https://github.com/hellraisercenobit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hellraisercenobit/skills"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:gate": "node scripts/build-gate-bundle.mjs",
    "changeset": "changeset",
    "check:axi": "node scripts/check-axi-surface.mjs",
    "check:contract": "node scripts/sync-suite-contract.mjs --check",
    "check:gate": "node scripts/build-gate-bundle.mjs --check",
    "install:hooks": "node scripts/install-gate-hooks.mjs",
    "link-skills": "bash scripts/link-skills.sh",
    "list-skills": "bash scripts/list-skills.sh",
    "smoke:browser": "node tests/browser/server.mjs",
    "stage:gate": "node scripts/stage-gate-package.mjs",
    "sync-version": "bash scripts/sync-version.sh",
    "sync:contract": "node scripts/sync-suite-contract.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:gate": "node --test tests/gate/*.test.mjs",
    "test:testing-browser": "npm --prefix tests/testing-patterns/project run browser",
    "test:testing-patterns": "npm --prefix tests/testing-patterns/project test && npm --prefix tests/testing-patterns/project run typecheck && npm --prefix tests/testing-patterns/compat test && npm --prefix tests/testing-patterns/compat run typecheck && node --test tests/testing-patterns/probes.test.mjs",
    "unstage:gate": "node scripts/stage-gate-package.mjs --clean",
    "version": "changeset version && bash scripts/sync-version.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.0.2"
}
